<Window x:Class="Ferry.DeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Delete" Width="430" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <!-- Borderless: DWM rounds the window and paints the border (see
         WindowEffects), so there is no frame to fight with. -->
    <StackPanel Margin="22,20,22,18">
        <TextBlock x:Name="TitleLine" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
        <TextBlock x:Name="BodyLine" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Dim}" LineHeight="19"
                   LineStackingStrategy="BlockLineHeight" />

        <!-- Only shown when the selection actually contains files, so the
             checkbox never asks about something that is not at stake. -->
        <Border x:Name="FileOption" Visibility="Collapsed" Margin="0,16,0,0"
                Background="{DynamicResource Surface3}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="10" Padding="12,11">
            <CheckBox x:Name="AlsoFiles">
                <StackPanel>
                    <TextBlock x:Name="FilesLine" TextWrapping="Wrap"
                               Foreground="{DynamicResource Ink}" />
                    <TextBlock x:Name="FilesHint" Margin="0,4,0,0" TextWrapping="Wrap"
                               FontSize="11" Foreground="{DynamicResource Faint}"
                               LineHeight="16" LineStackingStrategy="BlockLineHeight" />
                </StackPanel>
            </CheckBox>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="DeleteButton" Content="Delete"
                    Style="{StaticResource DangerButton}" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
