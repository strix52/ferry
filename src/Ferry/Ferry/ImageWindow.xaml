<Window x:Class="Ferry.ImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- Image Canvas viewport -->
        <Canvas x:Name="ViewportCanvas" Background="Transparent" ClipToBounds="True">
            <Image x:Name="DisplayImage">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="ImageTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Canvas>

        <!-- Navigation arrows overlay -->
        <Grid Margin="16,0">
            <Button x:Name="PrevButton" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Style="{StaticResource IconButton}" IsHitTestVisible="True"
                    Width="40" Height="40" Background="{DynamicResource Surface2}" Opacity="0.85"
                    ToolTip="Previous image (Left arrow)">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Path Style="{StaticResource IconPath}" Data="M15 18l-6-6 6-6" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button x:Name="NextButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource IconButton}" IsHitTestVisible="True"
                    Width="40" Height="40" Background="{DynamicResource Surface2}" Opacity="0.85"
                    ToolTip="Next image (Right arrow)">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Path Style="{StaticResource IconPath}" Data="M9 18l6-6-6-6" />
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>

        <!-- Top Caption Strip -->
        <Border x:Name="CaptionStrip" VerticalAlignment="Top"
                Background="{DynamicResource Surface2}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Padding="16,8,8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FilenameText" Style="{StaticResource TitleText}"
                               FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                    <TextBlock x:Name="SizeText" Style="{StaticResource MetaText}"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="IndexText" Style="{StaticResource FaintText}"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Button x:Name="SaveButton" Content="Save as…" Style="{StaticResource GhostButton}"
                            Padding="10,3" MinHeight="26" ToolTip="Save image (Ctrl+S)" />
                </StackPanel>

                <Button x:Name="CloseButton" Grid.Column="2" Content="&#xE8BB;"
                        Style="{StaticResource CloseCaptionButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTip="Close (Esc)" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
