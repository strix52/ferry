<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:Ferry">
  <!--
    Ferry "Passage" control library.

    Every control in this app was drawing itself with the stock Aero2 theme —
    grey gradient buttons, a blue system highlight, chunky scrollbars — which
    is the entire reason the window read as generic no matter what colours the
    thread objects used. This dictionary retemplates the handful of primitives Ferry
    actually uses so nothing falls back to Aero2.

    Conventions:
      * Colour comes from Themes/Dark.xaml and Themes/Light.xaml through
        DynamicResource ONLY. No literal colours below except the focus ring
        halo, which is alpha over whatever is underneath.
      * Interaction states are an overlay Border animated on Opacity rather
        than a swapped Background brush: it animates smoothly, needs no
        per-theme hover colour, and cannot freeze a shared brush.
      * Motion is 120ms in, 90ms out. Fast enough to feel immediate, slow
        enough to read as deliberate.
  -->

  <CornerRadius x:Key="RadiusSm">6</CornerRadius>
  <CornerRadius x:Key="RadiusMd">10</CornerRadius>
  <CornerRadius x:Key="RadiusLg">14</CornerRadius>
  <sys:Double x:Key="ControlHeight">30</sys:Double>

  <Duration x:Key="FadeIn">0:0:0.12</Duration>
  <Duration x:Key="FadeOut">0:0:0.09</Duration>

  <!-- ==================================================================
       Focus
       Aero2 draws a dotted 1px rectangle that disappears against dark
       surfaces. Replace it with a rounded accent halo drawn outside the
       control, so keyboard users can actually see where they are.
       ================================================================== -->
  <Style x:Key="FerryFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="{StaticResource RadiusMd}"
                  BorderThickness="2" SnapsToDevicePixels="True"
                  BorderBrush="{DynamicResource Accent}" Opacity="0.85" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================
       Text
       ================================================================== -->
  <Style x:Key="TitleText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="MetaText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Dim}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>

  <Style x:Key="FaintText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Faint}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- ==================================================================
       Buttons
       One template, three skins. The base Border carries the fill; Overlay
       carries hover/press; the whole thing scales down a hair when pressed
       so a click feels physical.
       ================================================================== -->
  <ControlTemplate x:Key="FerryButtonTemplate" TargetType="ButtonBase">
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
      <Border x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{Binding Path=(local:ButtonHelper.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
              SnapsToDevicePixels="True" />
      <Border x:Name="Overlay" Opacity="0"
              Background="{DynamicResource Hover}"
              CornerRadius="{Binding Path=(local:ButtonHelper.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
      <ContentPresenter x:Name="Content"
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        RecognizesAccessKey="True"
                        SnapsToDevicePixels="True" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Overlay"
                               Storyboard.TargetProperty="Opacity"
                               To="1" Duration="{StaticResource FadeIn}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Overlay"
                               Storyboard.TargetProperty="Opacity"
                               To="0" Duration="{StaticResource FadeOut}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Press}" />
        <!-- Set the whole transform rather than naming the ScaleTransform:
             elements inside a property element are not in the template's
             trigger name scope. -->
        <Setter TargetName="Root" Property="RenderTransform">
          <Setter.Value>
            <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.38" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- Secondary / default. Every unstyled Button in the app picks this up,
       which is what kills the Aero2 grey gradient outright. -->
  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource FerryButtonTemplate}" />
    <Setter Property="Background" Value="{DynamicResource Surface3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FerryFocusVisual}" />
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource GhostButton}" />

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,5" />
  </Style>

  <!-- Dedicated composer send button: circular oxidized-teal button, 44 DIPs,
       22 DIP radius, centered 20-DIP icon, normal disabled state and focus visual. -->
  <Style x:Key="ComposerSendButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="local:ButtonHelper.CornerRadius" Value="22" />
  </Style>

  <!-- Dedicated composer attach button: quiet circular icon control, 44 DIPs, 22 DIP radius -->
  <Style x:Key="ComposerAttachButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Surface3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Dim}" />
    <Setter Property="local:ButtonHelper.CornerRadius" Value="22" />
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Background" Value="{DynamicResource Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,5" />
  </Style>

  <!-- Chromeless: for actions that sit inside an object or a header, where a
       filled rectangle would compete with the content. -->
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Dim}" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="MinHeight" Value="26" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A quiet button that is nonetheless destructive. The hover setter is
       repeated rather than inherited: a BasedOn style's triggers run first, so
       QuietButton's hover would otherwise repaint this Ink on the way in. -->
  <Style x:Key="QuietDangerButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- ==================================================================
       TextBox
       ================================================================== -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
    <Setter Property="SelectionOpacity" Value="0.35" />
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderHi}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource RadiusMd}"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Auto" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Faint}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
            <Trigger Property="AcceptsReturn" Value="True">
              <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dedicated frameless composer text editor: transparent, no border, wraps, expands up to 120 DIPs -->
  <Style x:Key="ComposerTextBox" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
    <Setter Property="SelectionOpacity" Value="0.35" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <!-- Keep the empty editor no taller than the 44-DIP circular controls.
         Extra lines still grow the shelf upward to MaxHeight. -->
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost"
                        Margin="{TemplateBinding Padding}"
                        VerticalAlignment="Center"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Auto" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================
       CheckBox
       Used by the delete confirmation, where mis-reading the state costs the
       user a file. Big hit target, unmistakable checked state.
       ================================================================== -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FerryFocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Box" Width="18" Height="18"
                    VerticalAlignment="Top" Margin="0,1,9,0"
                    CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource Surface2}"
                    BorderBrush="{DynamicResource BorderHi}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
              <Path x:Name="Tick" Opacity="0"
                    Data="M 3.5 8 L 7 11.5 L 13.5 4.5"
                    Stroke="{DynamicResource AccentInk}"
                    StrokeThickness="2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" />
            </Border>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
              <Setter TargetName="Tick" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================
       ScrollBar
       Aero2's is 17px of grey with arrow buttons. This one is a 10px gutter
       with no arrows, and the thumb only reaches full contrast on hover.
       ================================================================== -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="{DynamicResource Faint}"
                  CornerRadius="4" Margin="3,2"
                  Opacity="0.55" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollTrack" TargetType="RepeatButton">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid x:Name="Root" Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollTrack}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="Grip" Style="{StaticResource ScrollThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollTrack}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Grip" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Height" Value="10" />
              <Setter Property="MinHeight" Value="10" />
              <Setter Property="Width" Value="Auto" />
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================
       ListBox / ListBoxItem
       The thread. Aero2's blue selection rectangle is replaced by an accent
       wash that respects the object's rounded corners.
       ================================================================== -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
              <ItemsPresenter SnapsToDevicePixels="True" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource RadiusMd}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <!-- Thread objects carry their own selection state so row width never
               introduces an unrelated band behind the chronological spine. -->
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================
       ProgressBar (upload/save progress)
       ================================================================== -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="5" />
    <Setter Property="Background" Value="{DynamicResource Surface3}" />
    <Setter Property="Foreground" Value="{DynamicResource Transfer}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="2.5" ClipToBounds="True" SnapsToDevicePixels="True">
            <Grid x:Name="PART_Track">
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                      CornerRadius="2.5"
                      Background="{TemplateBinding Foreground}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================
       ContextMenu (per-message Copy / Pin / Delete)
       ================================================================== -->
  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource Surface}"
                  BorderBrush="{DynamicResource BorderHi}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource RadiusMd}"
                  Padding="4"
                  SnapsToDevicePixels="True">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#000000" />
            </Border.Effect>
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd" Background="Transparent"
                  CornerRadius="{StaticResource RadiusSm}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource Faint}"
                         Text="{TemplateBinding InputGestureText}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="6,4"
                  Background="{DynamicResource Border}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================
       ToolTip
       ================================================================== -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource Surface}"
                  BorderBrush="{DynamicResource BorderHi}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource RadiusSm}"
                  Padding="8,5">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================
       Caption buttons
       WindowChrome hides the system ones (UseAeroCaptionButtons=False), so
       the app draws its own. Sizes match the Windows 11 caption exactly —
       46x32 with the Fluent glyphs — because muscle memory for the close
       button is worth more than any styling idea.
       ================================================================== -->
  <ControlTemplate x:Key="CaptionButtonTemplate" TargetType="Button">
    <Grid Background="Transparent">
      <Border x:Name="Bd" Background="Transparent" />
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Press}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource CaptionButtonTemplate}" />
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Foreground" Value="{DynamicResource Dim}" />
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="IsTabStop" Value="False" />
  </Style>

  <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Border x:Name="Bd" Background="Transparent" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Danger}" />
              <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Danger}" />
              <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
              <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
