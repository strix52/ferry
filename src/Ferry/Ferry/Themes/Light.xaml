<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!--
    Ferry "Passage" — light. Same token names as Dark.xaml and as
    public/style.css; Dark.xaml carries the rules that govern them.

    Contrast against the ground each one is meant for: Ink 15.9:1, Dim 5.1:1,
    Faint 4.3:1 (decorative only, never body text), Accent 5.8:1, AccentInk
    on Accent 5.8:1.
  -->

  <Color x:Key="BgColor">#F4F3EF</Color>
  <Color x:Key="BgGlowColor">#E3ECE8</Color>
  <Color x:Key="SurfaceColor">#FBFBF8</Color>
  <Color x:Key="Surface2Color">#FFFFFF</Color>
  <Color x:Key="Surface3Color">#ECEDEA</Color>
  <Color x:Key="BorderColor">#DADDD8</Color>
  <Color x:Key="BorderHiColor">#C7CDC7</Color>
  <Color x:Key="InkColor">#17211F</Color>
  <Color x:Key="DimColor">#52615D</Color>
  <Color x:Key="FaintColor">#66736F</Color>
  <Color x:Key="AccentColor">#0F5F5D</Color>
  <Color x:Key="AccentHiColor">#084B4A</Color>
  <Color x:Key="AccentInkColor">#FFFFFF</Color>
  <Color x:Key="AccentSoftColor">#DDEBE7</Color>
  <Color x:Key="BubbleMineColor">#E7EFEC</Color>
  <Color x:Key="SignalColor">#168A68</Color>
  <Color x:Key="TransferColor">#8B456D</Color>
  <Color x:Key="TransferSoftColor">#F1E4EB</Color>
  <Color x:Key="WarnColor">#966116</Color>
  <Color x:Key="DangerColor">#B33A4A</Color>

  <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="BgGlow" Color="{StaticResource BgGlowColor}" />
  <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
  <SolidColorBrush x:Key="Surface3" Color="{StaticResource Surface3Color}" />
  <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderHi" Color="{StaticResource BorderHiColor}" />
  <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="Dim" Color="{StaticResource DimColor}" />
  <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHi" Color="{StaticResource AccentHiColor}" />
  <SolidColorBrush x:Key="AccentInk" Color="{StaticResource AccentInkColor}" />
  <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="BubbleMine" Color="{StaticResource BubbleMineColor}" />
  <SolidColorBrush x:Key="Signal" Color="{StaticResource SignalColor}" />
  <SolidColorBrush x:Key="Transfer" Color="{StaticResource TransferColor}" />
  <SolidColorBrush x:Key="TransferSoft" Color="{StaticResource TransferSoftColor}" />
  <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
  <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />

  <SolidColorBrush x:Key="Hover" Color="#0F171A24" />
  <SolidColorBrush x:Key="Press" Color="#1F171A24" />
  <SolidColorBrush x:Key="Selected" Color="#280F5F5D" />
  <SolidColorBrush x:Key="DangerSoft" Color="#26B33A4A" />

  <SolidColorBrush x:Key="MicaVeil" Color="#C7F4F3EF" />

  <SolidColorBrush x:Key="HeaderWash" Color="#F8F8F4" />

  <sys:Boolean x:Key="ThemeIsDark">False</sys:Boolean>

  <!-- Legacy aliases; see Dark.xaml. -->
  <SolidColorBrush x:Key="PageBg" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="BubbleMineBg" Color="{StaticResource BubbleMineColor}" />
  <SolidColorBrush x:Key="BubbleMineInk" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="BubbleOtherBg" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="BubbleOtherInk" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="CardBorder" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="InputBg" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="InputBorder" Color="{StaticResource BorderHiColor}" />
</ResourceDictionary>
