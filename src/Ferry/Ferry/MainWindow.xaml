<Window x:Class="Ferry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Ferry"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="Ferry" Height="680" Width="580" MinHeight="420" MinWidth="430"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Background="Transparent" Foreground="{DynamicResource Ink}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <!-- The window owns its whole frame now: the stock title bar was a light
         grey strip sitting above a dark app, which is most of why the window
         read as generic. The primary shell deliberately stays opaque so its
         custom caption remains one continuous color over every wallpaper. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <sys:Double x:Key="ThreadContentMaxWidth">840</sys:Double>

        <Style x:Key="PassageObject" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PassageMeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Dim}" />
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <DataTemplate x:Key="TextTemplate">
            <Grid x:Name="Row" Margin="4,3,14,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,12,8,0" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TimeText, Mode=OneWay}" Style="{StaticResource PassageMeta}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding DisplayName, Mode=OneWay}" Style="{StaticResource PassageMeta}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid Grid.Column="1">
                    <Border Width="1" Background="{DynamicResource Border}" HorizontalAlignment="Center" />
                    <Ellipse Width="9" Height="9" Margin="0,17,0,0" VerticalAlignment="Top"
                             Fill="{DynamicResource Bg}" Stroke="{DynamicResource Accent}" StrokeThickness="2" />
                </Grid>
                <Border x:Name="Object" Grid.Column="2" Style="{StaticResource PassageObject}" Padding="12,7">
                    <Grid>
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock local:LinkifiedText.Text="{Binding Text}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Ink}" FontSize="13.5"
                                       LineHeight="19" LineStackingStrategy="BlockLineHeight" />
                        </StackPanel>
                        <Button x:Name="CopyBtn" Content="Copy" Style="{StaticResource QuietButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="Copy message text" Click="RowCopy_Click" />
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Value="True"
                             Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                    <Setter TargetName="Object" Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="FileTemplate">
            <Grid x:Name="Row" Margin="4,7,14,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,14,8,0" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TimeText, Mode=OneWay}" Style="{StaticResource PassageMeta}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding DisplayName, Mode=OneWay}" Style="{StaticResource PassageMeta}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid Grid.Column="1">
                    <Border Width="1" Background="{DynamicResource Border}" HorizontalAlignment="Center" />
                    <Ellipse Width="10" Height="10" Margin="0,19,0,0" VerticalAlignment="Top"
                             Fill="{DynamicResource Accent}" Stroke="{DynamicResource Bg}" StrokeThickness="2" />
                </Grid>
                <Border x:Name="Object" Grid.Column="2" Style="{StaticResource PassageObject}"
                        HorizontalAlignment="Left" MaxWidth="520">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.09" Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Ink}" FontSize="16" FontWeight="SemiBold">
                                <Run Text="{Binding Headline, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding SizeText, Mode=OneWay}" Foreground="{DynamicResource Dim}" FontSize="12" Margin="0,2,0,0" />
                            <Border Margin="0,8,0,0" CornerRadius="10" ClipToBounds="True"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Surface3}"
                                    local:ThumbnailSilhouette.Source="{Binding Thumb, Mode=OneWay}"
                                    MaxHeight="220"
                                    Visibility="{Binding ShowThumb, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Image MaxHeight="220" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Source="{Binding Thumb, Mode=OneWay}"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       MouseLeftButtonUp="Thumb_Click" Cursor="Hand"
                                       ToolTip="Open" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="-9,8,0,-2">
                                <Button Content="Open" Tag="open"
                                        Style="{StaticResource QuietButton}"
                                        Click="FileAction_Click" IsEnabled="{Binding CanAct, Mode=OneWay}" />
                                <Button Content="Folder" Tag="reveal"
                                        Style="{StaticResource QuietButton}"
                                        Click="FileAction_Click" IsEnabled="{Binding CanAct, Mode=OneWay}" />
                                <Button Content="Save as" Tag="save"
                                        Style="{StaticResource QuietButton}"
                                        Click="FileAction_Click" IsEnabled="{Binding CanAct, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="CopyBtn" Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-4,-6,0" Width="24" Height="24"
                                Opacity="0.35" ToolTip="Copy filename" Click="RowCopy_Click">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCopy}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                    <Setter TargetName="CopyBtn" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Row}" Value="True">
                    <Setter TargetName="CopyBtn" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Value="True"
                             Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                    <Setter TargetName="CopyBtn" Property="Opacity" Value="1" />
                    <Setter TargetName="Object" Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SeparatorTemplate">
            <Border Margin="96,16,14,8" Padding="0,0,0,7"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                    IsHitTestVisible="False" Focusable="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUnreadDivider}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Text}" FontSize="11.5" FontWeight="SemiBold"
                           HorizontalAlignment="Left">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Dim}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnreadDivider}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <local:ThreadTemplateSelector x:Key="ThreadSelector"
            TextTemplate="{StaticResource TextTemplate}"
            FileTemplate="{StaticResource FileTemplate}"
            SeparatorTemplate="{StaticResource SeparatorTemplate}" />
    </Window.Resources>

    <!-- Backdrop is the window ground. The main shell stays opaque so its
         custom caption reads as one continuous surface over any wallpaper. -->
    <Border x:Name="Backdrop" Background="{DynamicResource Bg}">
        <Grid x:Name="RootPad">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <!-- A WindowChrome window sizes itself to the whole
                             monitor when maximized, pushing its edges under the
                             taskbar. Pad the content back into the work area. -->
                        <DataTrigger Value="Maximized"
                                     Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Setter Property="Margin" Value="7" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar: identity, live status, window buttons. Anything not
                 marked IsHitTestVisibleInChrome drags the window. -->
            <Grid Grid.Row="0" Height="56">
                <Border Background="{DynamicResource HeaderWash}" Opacity="0.55" />
                <Border VerticalAlignment="Bottom" Height="1"
                        Background="{DynamicResource Border}" />
                <Grid Margin="14,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The Passage mark: three currents, shared with favicon.svg. -->
                    <Viewbox Grid.Column="0" Width="30" Height="30" VerticalAlignment="Center">
                        <Canvas Width="32" Height="32">
                            <Canvas.Resources>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="{DynamicResource Accent}" />
                                    <Setter Property="StrokeThickness" Value="2.7" />
                                    <Setter Property="StrokeStartLineCap" Value="Round" />
                                    <Setter Property="StrokeEndLineCap" Value="Round" />
                                </Style>
                            </Canvas.Resources>
                            <Path Data="M5 9.5 C8.4 6.8 11.2 6.8 14.6 9.5 S20.8 12.2 27 9.5" />
                            <Path Data="M5 16 C8.4 13.3 11.2 13.3 14.6 16 S20.8 18.7 27 16" />
                            <Path Data="M5 22.5 C8.4 19.8 11.2 19.8 14.6 22.5 S20.8 25.2 27 22.5" />
                        </Canvas>
                    </Viewbox>

                    <Grid Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                        <StackPanel x:Name="TitleAndStatusPanel" VerticalAlignment="Center">
                            <TextBlock Text="Ferry" Style="{StaticResource TitleText}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="StatusText" Style="{StaticResource MetaText}"
                                           Text="Connecting…" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PresenceText" Style="{StaticResource MetaText}"
                                           Foreground="{DynamicResource Signal}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <TextBox x:Name="FilterBox"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Center"
                                 Height="28"
                                 Padding="8,4"
                                 FontSize="12"
                                 ToolTip="Filter messages (Esc to close)"
                                 shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="ConnectButton" Content="Connect"
                                Style="{StaticResource QuietButton}"
                                ToolTip="Pair a phone"
                                Margin="0,0,6,0" />
                        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}"
                                ToolTip="Settings" Width="32" Height="32">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconGear}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                VerticalAlignment="Top"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinButton" Content="&#xE921;"
                                Style="{StaticResource CaptionButton}" ToolTip="Minimize" />
                        <Button x:Name="MaxButton" Content="&#xE922;"
                                Style="{StaticResource CaptionButton}" ToolTip="Maximize" />
                        <Button x:Name="CloseButton" Content="&#xE8BB;"
                                Style="{StaticResource CloseCaptionButton}" ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Pinned messages strip -->
            <Border x:Name="PinnedStrip" Grid.Row="1" Margin="14,4,14,0" Visibility="Collapsed"
                    MaxWidth="{StaticResource ThreadContentMaxWidth}" HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                    CornerRadius="0">
                <StackPanel>
                    <Button x:Name="PinnedToggle" Style="{StaticResource QuietButton}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="8,6" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconLink}"
                                          Stroke="{DynamicResource Accent}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="PinnedToggleText" Text="Pinned · 0" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ItemsControl x:Name="PinnedItemsList" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="8,5">
                                    <Grid Cursor="Hand" Background="Transparent" MouseLeftButtonUp="PinnedItem_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Text is set by the style below, never locally: a local value
                                             outranks a Style setter in WPF, so an attribute here would
                                             pin the badge to whatever it bound and silence the trigger. -->
                                        <TextBlock Grid.Column="0"
                                                   Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="FILE" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsText}" Value="True">
                                                            <Setter Property="Text" Value="NOTE" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Headline}" TextTrimming="CharacterEllipsis"
                                                   FontSize="12" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Deleted}" Value="True">
                                                            <Setter Property="Opacity" Value="0.6" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="2" Content="Unpin" Style="{StaticResource QuietButton}"
                                                Padding="6,2" FontSize="11" Click="UnpinItem_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ListBox x:Name="ThreadList" Grid.Row="3" Margin="10,8,6,0" Padding="4,2"
                     MaxWidth="{StaticResource ThreadContentMaxWidth}" HorizontalAlignment="Stretch"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ItemTemplateSelector="{StaticResource ThreadSelector}"
                     SelectionMode="Extended">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ContextMenu>
                    <!-- Acts on the whole selection, not on the row under the
                         cursor; PreviewMouseRightButtonDown in code-behind makes
                         sure that row is part of it before the menu opens. -->
                    <ContextMenu>
                        <MenuItem x:Name="PinMenuItem" Header="Pin" />
                        <MenuItem x:Name="CopyMenuItem" Header="Copy text" InputGestureText="Ctrl+C" />
                        <Separator />
                        <MenuItem x:Name="DeleteMenuItem" Header="Delete…" InputGestureText="Del" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <Border x:Name="UploadRow" Grid.Row="2" Margin="14,10,14,0" Visibility="Collapsed"
                    MaxWidth="{StaticResource ThreadContentMaxWidth}" HorizontalAlignment="Stretch"
                    Background="{DynamicResource Surface2}"
                    BorderBrush="{DynamicResource BorderHi}" BorderThickness="1"
                    CornerRadius="14" Padding="14,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.12" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource TransferSoft}"
                            VerticalAlignment="Center">
                        <Viewbox Width="21" Height="21">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFile}" Stroke="{DynamicResource Transfer}" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                        <TextBlock x:Name="UploadLabel" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="UploadQueueText" Margin="0,2,0,0"
                                   Style="{StaticResource PassageMeta}" Visibility="Collapsed" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="UploadBar" Grid.Column="0" VerticalAlignment="Center"
                                         Foreground="{DynamicResource Transfer}" Minimum="0" Maximum="100" />
                            <TextBlock x:Name="UploadPercentText" Grid.Column="1" Margin="10,0,0,0"
                                       Text="0%" Style="{StaticResource PassageMeta}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CancelTransferButton" Content="Cancel" Visibility="Collapsed"
                                Style="{StaticResource QuietButton}" />
                        <Button x:Name="RetryButton" Content="Retry" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Only present while something is selected, so the composer sits
                 at the bottom of the window the rest of the time. -->
            <Border x:Name="SelectionBar" Grid.Row="4" Visibility="Collapsed"
                    MaxWidth="{StaticResource ThreadContentMaxWidth}" HorizontalAlignment="Stretch"
                    Margin="14,8,14,0"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource BorderHi}" BorderThickness="1"
                    CornerRadius="12" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectionText" Grid.Column="0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Ink}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,-9,0">
                        <Button x:Name="SelectionCopyButton" Content="Copy"
                                Style="{StaticResource QuietButton}" />
                        <Button x:Name="SelectionDeleteButton" Content="Delete"
                                Style="{StaticResource QuietDangerButton}" />
                        <Button x:Name="SelectionClearButton" Content="Clear"
                                Style="{StaticResource QuietButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Unified composer shelf -->
            <Border x:Name="ComposerShelf" Grid.Row="5"
                    Margin="14,10,14,14"
                    MaxWidth="{StaticResource ThreadContentMaxWidth}"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource Surface2}"
                    BorderThickness="1"
                    CornerRadius="26"
                    Padding="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Composer}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AttachButton" Grid.Column="0"
                            Style="{StaticResource ComposerAttachButton}"
                            ToolTip="Attach file"
                            VerticalAlignment="Bottom">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconAdd}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <TextBox x:Name="Composer" Grid.Column="1"
                             Style="{StaticResource ComposerTextBox}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxHeight="120"
                             VerticalScrollBarVisibility="Auto"
                             VerticalAlignment="Center" />
                    <Button x:Name="SendButton" Grid.Column="2"
                            IsEnabled="False" ToolTip="Send"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource ComposerSendButton}">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSend}"
                                      Stroke="{DynamicResource AccentInk}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
