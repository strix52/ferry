<Window x:Class="Ferry.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Clean up files" Width="430" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <StackPanel Margin="22,20,22,18">
        <TextBlock Text="Clean up files" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Dim}" LineHeight="19"
                   LineStackingStrategy="BlockLineHeight"
                   Text="Deletes stored files; keeps their thread entries." />

        <TextBlock Margin="0,16,0,8" Text="Older than" Style="{StaticResource MetaText}" />

        <WrapPanel x:Name="AgeButtons" Margin="0,0,0,8">
            <Button x:Name="Days7Btn" Content="7 days" Tag="7" Margin="0,0,8,6" Style="{StaticResource GhostButton}" />
            <Button x:Name="Days15Btn" Content="15 days" Tag="15" Margin="0,0,8,6" Style="{StaticResource GhostButton}" />
            <Button x:Name="Days30Btn" Content="30 days" Tag="30" Margin="0,0,8,6" Style="{StaticResource GhostButton}" />
            <Button x:Name="CustomBtn" Content="Custom" Tag="custom" Margin="0,0,8,6" Style="{StaticResource GhostButton}" />
        </WrapPanel>

        <TextBox x:Name="CustomDaysBox" Visibility="Collapsed" Margin="0,0,0,10"
                 Padding="8,5" MaxLength="4" />

        <Border Background="{DynamicResource Surface3}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="10" Padding="12,11" Margin="0,4,0,0">
            <TextBlock x:Name="ImpactLine" TextWrapping="Wrap"
                       Foreground="{DynamicResource Ink}"
                       Text="Choose an age." />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="CleanupButton" Content="Delete files"
                    Style="{StaticResource DangerButton}" IsDefault="True" IsEnabled="False" />
        </StackPanel>
    </StackPanel>
</Window>
